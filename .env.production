VITE_BASE_URL="https://synapse.omni.dev"
VITE_API_BASE_URL="https://api.synapse.omni.dev"
VITE_AUTH_BASE_URL="https://identity.omni.dev"
VITE_ACCOUNT_URL="https://account.omni.dev"

# OAuth client credentials injected as Fractal/k8s secrets at deploy time
AUTH_CLIENT_ID=""
AUTH_CLIENT_SECRET=""


# billing (Aether), injected as Fractal/k8s secrets at deploy time
VITE_BILLING_BASE_URL=""
BILLING_SERVICE_API_KEY=""

# authorization (Warden), baked at build (VITE_ client vars inline from .env.production, not runtime secrets)
VITE_AUTHZ_API_URL="https://api.access.omni.dev"
VITE_AUTHZ_ENABLED="true"

# feature flags
VITE_FLAGS_API_HOST=https://flags.omni.dev/api
