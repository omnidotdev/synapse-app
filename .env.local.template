# auth (generate AUTH_SECRET with: `openssl rand -base64 32`)
# https://www.better-auth.com/docs/reference/options#secret
AUTH_SECRET=""
# OAuth provider credentials (required for sign-in; the provider is skipped if unset)
AUTH_CLIENT_ID=""
AUTH_CLIENT_SECRET=""

# external provider URLs
# VITE_AUTH_BASE_URL=
# VITE_BILLING_BASE_URL=

# authorization (Warden) - optional; checks are skipped when unset
# VITE_AUTHZ_API_URL=
# VITE_AUTHZ_ENABLED=true

# Synapse API URL (override for non-default setups)
# SYNAPSE_API_URL=
