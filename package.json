{
  "name": "@omnidotdev/synapse-app",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "Omni <team@omni.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/omnidotdev/synapse-app.git"
  },
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "concurrently --kill-others --names \"GRAPHQL-CODEGEN,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"bun run graphql:generate:watch\" \"vite dev\"",
    "build": "vite build",
    "serve": "vite preview",
    "start": "node .output/server/index.mjs",
    "icons:generate": "bun scripts/generateIcons.ts",
    "graphql:generate": "NODE_PATH=src/ dotenv -e .env.development -- graphql-codegen --config src/lib/graphql/codegen.config.ts",
    "graphql:generate:watch": "bun graphql:generate -w",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check --diagnostic-level=error src",
    "knip": "knip-bun --tags=-knipignore",
    "pwa:audit": "unlighthouse-ci --site https://localhost:3000",
    "test": "bun test src",
    "test:watch": "bun test src --watch",
    "test:coverage": "bun test src --coverage",
    "test:e2e": "NODE_ENV=test playwright test",
    "test:e2e:ui": "NODE_ENV=test playwright test --ui",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@faker-js/faker": "^10.6.0",
    "@graphql-codegen/add": "^6.0.1",
    "@graphql-codegen/cli": "^6.3.1",
    "@graphql-codegen/import-types-preset": "^4.0.1",
    "@graphql-codegen/plugin-helpers": "^6.3.0",
    "@graphql-codegen/typescript": "^5.0.10",
    "@graphql-codegen/typescript-graphql-request": "^7.1.0",
    "@graphql-codegen/typescript-msw": "^4.0.1",
    "@graphql-codegen/typescript-operations": "^5.1.0",
    "@graphql-codegen/typescript-react-query": "^7.0.5",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@happy-dom/global-registrator": "^20.14.5",
    "@playwright/test": "^1.63.0",
    "@tanstack/devtools-vite": "^0.6.1",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@unlighthouse/cli": "^0.18.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "knip": "^6.14.1",
    "msw": "^2.15.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vite-imagetools": "^10.0.1",
    "vite-plugin-mkcert": "^2.1.0"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.2",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "@omnidotdev/providers": "github:omnidotdev/providers#ce5e90e0d0c40458d23b20c62a16568291c8b8cf",
    "@omnidotdev/thornberry": "github:omnidotdev/thornberry#372ebb2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/nitro-v2-vite-plugin": "1.155.2",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.56",
    "@tanstack/react-table": "8.21.3",
    "better-auth": "1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hotkeys-hook": "^5.3.3",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "~0.186.0",
    "tw-animate-css": "^1.4.0",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "^4.6.5"
  },
  "overrides": {
    "@tanstack/query-core": "^5.101.2"
  },
  "trustedDependencies": [
    "@omnidotdev/providers",
    "@parcel/watcher"
  ]
}
